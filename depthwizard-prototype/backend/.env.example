# Copy to backend/.env (or export these directly) to configure DepthWizard.
# All are optional — sane defaults are used if unset.

# --- Inference / serving ---
# Path to a local fine-tuned Depth Anything checkpoint directory (must
# contain config.json, model.safetensors, and preprocessor_config.json).
# Falls back to backend/models/depth-anything-gamus, then the public
# LiheYoung/depth-anything-small-hf checkpoint if unset/missing.
DEPTHWIZARD_CHECKPOINT=

# Where uploaded jobs (input image, depth preview, DSM, terrain.glb) are written.
OUTPUT_DIR=backend/outputs

# Max accepted size (bytes) for the main upload, reference DEM, and GCP file.
MAX_UPLOAD_SIZE=52428800

# Max accepted decoded raster size (width*height pixels), independent of file size.
MAX_IMAGE_PIXELS=50000000

# Comma-separated CORS origins. Defaults to localhost:8010 only — the
# frontend is same-origin (served by this app), so this rarely needs changing.
ALLOWED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010

# Delete job output directories older than this many hours (0 disables).
OUTPUT_RETENTION_HOURS=24

# Max concurrent depth-inference/mesh-build jobs processed at once.
MAX_CONCURRENT_JOBS=2

LOG_LEVEL=INFO

# --- Training / data prep (training/*.py only, not the server) ---
GAMUS_CROISSANT_URL=https://huggingface.co/api/datasets/earthflow/GAMUS/croissant
GAMUS_MAX_RECORDS=
GAMUS_CACHE_DIR=training/gamus_cache
GAMUS_LOCAL_ROOT=
